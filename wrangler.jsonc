/**
 * Cloudflare Worker config for MCEval.
 * Built with OpenNext for Cloudflare and bound to D1.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mceval",
  "main": "worker.ts",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mceval",
      "database_id": "fffb2516-c2d8-457b-ad4d-98e595cf8d92",
      "migrations_dir": "./db/migrations",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "queues": {
    "producers": [
      {
        "queue": "mceval-eval-jobs",
        "binding": "EVAL_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "mceval-eval-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "mceval-eval-jobs-dlq",
      },
    ],
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mceval",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "AUTH_ORIGIN": "https://auth.kaf.sh",
    "MCEVAL_ADMIN_USER_IDS": "517599684961894400",
  },
  "routes": [
    {
      "pattern": "mceval.kaf.sh",
      "custom_domain": true,
    },
  ],
}
